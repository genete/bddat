venv/
instance/
*.pyc
__pycache__/
.env
*.db
app/static/uploads/*
# Artefactos de Claude Code / Playwright MCP
.playwright-mcp/
# Artefactos locales de Claude Code (no versionar config/caché/sesiones)
# Se ignora el contenido pero no el directorio, para poder exceptuar skills/
.claude/*
!.claude/skills
!.claude/launch.json
!.claude/settings.json
# hooks/ va versionado porque settings.json (versionado) lo referencia:
# sin él, un worktree o clon nuevo rompe el hook en cada comando Bash
!.claude/hooks
# Documentos de prueba locales (no versionar binarios ni datos reales)
docs_prueba/
# Árbol de ficheros de la suite de tests (#849): lo que escriban los tests
# nunca debe caer en docs_prueba/, que es el servidor de ficheros de desarrollo
docs_prueba_test/
contexto_completo_gemini.txt

# Contexto de issues generado por scripts/gen_issues.py (no versionar)
.issues/

# React+Vite — artefactos de build (#291 POC, #499 scaffolding multi-bundle)
react-src/node_modules/
# Bundles compilados: se ignora el contenido salvo el manifest (lo lee react_bundle)
app/static/js/react/*
!app/static/js/react/manifest.json
