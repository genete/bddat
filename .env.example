# ================================
# BDDAT - Configuration Template
# ================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Replace placeholder values with your actual configuration
# 3. NEVER commit .env to version control (it's in .gitignore)
#

# Flask Application
FLASK_APP=run.py
FLASK_ENV=development

# Security Configuration
# ⚠️ CRITICAL: Generate a secure key for production!
# Run: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-cambiar-en-produccion

# Database Configuration
# Format: postgresql://username:password@host:port/database
# Development example:
DATABASE_URL=postgresql://bddat_admin:your_password_here@localhost:5432/bddat

# Base de datos de TESTS (#849) — obligatoria para ejecutar la suite.
# DEBE ser una base distinta de la de desarrollo: `scripts/preparar_bd_test.py`
# la borra y la reconstruye desde las migraciones. Sin esta variable la suite
# no arranca, a propósito: es preferible eso a que escriba donde no debe.
# El arranque comprueba que no se cruzan los dos mundos y aborta si lo hacen.
TEST_DATABASE_URL=postgresql://bddat_admin:your_password_here@localhost:5432/bddat_test

# Árbol de ficheros de la suite de tests (#849). Mismo motivo que la base
# aparte: el sistema de ficheros no es transaccional, así que un test que
# genere un escrito o suba al pool deja el fichero puesto aunque su transacción
# se deshaga. Con raíz propia, eso nunca cae en el árbol de desarrollo.
TEST_FILESYSTEM_BASE=D:/BDDAT/docs_prueba_test
TEST_PLANTILLAS_BASE=D:/BDDAT/docs_prueba_test/plantillas_escritos

# Optional: Debug mode (set to False in production)
DEBUG=True

# Optional: Database connection pool settings
# SQLALCHEMY_POOL_SIZE=5
# SQLALCHEMY_MAX_OVERFLOW=10
